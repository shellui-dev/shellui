<section class="border border-border rounded-lg p-6 bg-card">
    <h2 class="text-2xl font-semibold mb-1 text-card-foreground">Stat Card</h2>
    <p class="text-sm text-muted-foreground mb-4">KPI tiles with a trend badge.</p>
    <div class="grid gap-4 sm:grid-cols-3">
        <StatCard Title="Revenue" Value="$45,231" Change="+20.1%" Trend="up" Description="vs last month" />
        <StatCard Title="Error rate" Value="0.42%" Change="-0.8%" Trend="down" Description="last 24 hours" />
        <StatCard Title="Active users" Value="2,350" Description="right now" />
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-1 text-card-foreground">Chat</h2>
    <p class="text-sm text-muted-foreground mb-4">Enter sends, Shift+Enter adds a new line. Replies are simulated.</p>
    <Chat Height="380px">
        <Header>
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-foreground">Assistant</span>
                <span class="text-xs text-muted-foreground">@_messages.Count messages</span>
            </div>
        </Header>
        <ChildContent>
            @foreach (var message in _messages)
            {
                <ChatMessage Role="@message.Role" Name="@(message.Role == "user" ? "You" : "ShellUI")" Text="@message.Text" />
            }
            @if (_thinking)
            {
                <ChatMessage Role="assistant" Name="ShellUI" IsStreaming="true" />
            }
        </ChildContent>
        <Footer>
            @if (_messages.Count == 1)
            {
                <PromptSuggestions Suggestions="_suggestions" OnSelect="SendAsync" Disabled="_thinking" Class="mb-3" />
            }
            <ChatInput @bind-Value="_draft" OnSubmit="SendAsync" IsLoading="_thinking" />
        </Footer>
    </Chat>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <div>
            <h2 class="text-2xl font-semibold mb-1 text-card-foreground">Reasoning &amp; Tool Call</h2>
            <p class="text-sm text-muted-foreground">Reasoning opens while it streams and folds away when done. The tool call goes from running to done.</p>
        </div>
        <Button Variant="ButtonVariant.Outline" OnClick="RunAgentAsync" Disabled="_agentRunning">@(_agentRunning ? "Running…" : "Run")</Button>
    </div>
    <div class="space-y-3">
        <Reasoning Text="@_reasoning" IsStreaming="_reasoningStreaming" Duration="_reasoningTime" />
        <ToolCall Name="search_docs" State="@_toolState" Arguments="@ToolArguments" Result="@_toolResult" />
        <ToolCall Name="send_email" State="error" Arguments="@("{ \"to\": \"team@example.com\" }")" Error="SMTP server refused the connection." />
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-1 text-card-foreground">Field</h2>
    <p class="text-sm text-muted-foreground mb-4">Label, control, description and error as one unit. Submit with the email empty to see validation.</p>
    <EditForm Model="_signup" OnValidSubmit="() => _signedUp = true" class="grid max-w-md gap-4">
        <DataAnnotationsValidator />
        <Field Label="Email" LabelFor="field-email" Required="true" Description="We'll only use it for release notes." For="() => _signup.Email">
            <Input id="field-email" @bind-Value="_signup.Email" Placeholder="you@example.com" />
        </Field>
        <Field Label="Weekly digest" Description="A short summary every Monday." Orientation="horizontal">
            <Switch @bind-Checked="_signup.Digest" />
        </Field>
        <div class="flex items-center gap-3">
            <Button Type="submit">Subscribe</Button>
            @if (_signedUp)
            {
                <span class="text-sm text-muted-foreground">Subscribed.</span>
            }
        </div>
    </EditForm>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-1 text-card-foreground">JSON Viewer</h2>
    <p class="text-sm text-muted-foreground mb-4">Two levels open by default. Click a key to fold it, or copy the whole document.</p>
    <JsonViewer Value="_sampleJson" Class="max-h-80" />
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-1 text-card-foreground">Resizable</h2>
    <p class="text-sm text-muted-foreground mb-4">Drag a handle, or focus it with Tab and use the arrow keys, Home and End. Layout: @string.Join(" / ", _layout.Select(s => $"{s:0}%"))</p>
    <div class="h-72 overflow-hidden rounded-lg border border-border">
        <ResizablePanelGroup OnLayout="sizes => _layout = sizes">
            <ResizablePanel DefaultSize="20" MinSize="15" MaxSize="35">
                <div class="flex h-full items-center justify-center p-4 text-sm font-medium">Sidebar</div>
            </ResizablePanel>
            <ResizableHandle WithHandle="true" />
            <ResizablePanel MinSize="30">
                <ResizablePanelGroup Direction="vertical">
                    <ResizablePanel DefaultSize="65">
                        <div class="flex h-full items-center justify-center p-4 text-sm font-medium">Editor</div>
                    </ResizablePanel>
                    <ResizableHandle WithHandle="true" />
                    <ResizablePanel MinSize="15">
                        <div class="flex h-full items-center justify-center p-4 text-sm font-medium">Terminal</div>
                    </ResizablePanel>
                </ResizablePanelGroup>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel DefaultSize="25">
                <div class="flex h-full items-center justify-center p-4 text-sm font-medium">Inspector</div>
            </ResizablePanel>
        </ResizablePanelGroup>
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-4 text-card-foreground">Toggle Group &amp; Button Group</h2>
    <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-4">
            <ToggleGroup @bind-Value="_align">
                <ToggleGroupItem Value="left">Left</ToggleGroupItem>
                <ToggleGroupItem Value="center">Center</ToggleGroupItem>
                <ToggleGroupItem Value="right">Right</ToggleGroupItem>
            </ToggleGroup>
            <span class="text-sm text-muted-foreground">Single: @(_align ?? "none")</span>
        </div>
        <div class="flex flex-wrap items-center gap-4">
            <ToggleGroup Multiple="true" @bind-Values="_formats">
                <ToggleGroupItem Value="bold"><span class="font-bold">B</span></ToggleGroupItem>
                <ToggleGroupItem Value="italic"><span class="italic">I</span></ToggleGroupItem>
                <ToggleGroupItem Value="underline"><span class="underline">U</span></ToggleGroupItem>
            </ToggleGroup>
            <span class="text-sm text-muted-foreground">Multiple: @(_formats.Count == 0 ? "none" : string.Join(", ", _formats))</span>
        </div>
        <div class="flex flex-wrap items-start gap-6">
            <ButtonGroup>
                <Button Variant="ButtonVariant.Outline">Day</Button>
                <Button Variant="ButtonVariant.Outline">Week</Button>
                <Button Variant="ButtonVariant.Outline">Month</Button>
            </ButtonGroup>
            <ButtonGroup Orientation="vertical">
                <Button Variant="ButtonVariant.Outline">Top</Button>
                <Button Variant="ButtonVariant.Outline">Middle</Button>
                <Button Variant="ButtonVariant.Outline">Bottom</Button>
            </ButtonGroup>
        </div>
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-4 text-card-foreground">Input Group &amp; Number Input</h2>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
            <InputGroup @bind-Value="_website" Placeholder="example">
                <Prefix>https://</Prefix>
                <Suffix>.com</Suffix>
            </InputGroup>
            <InputGroup @bind-Value="_price" Placeholder="0.00" Type="number">
                <Prefix>$</Prefix>
                <Suffix>USD</Suffix>
            </InputGroup>
        </div>
        <div class="space-y-2">
            <NumberInput @bind-Value="_quantity" Min="0" Max="10" />
            <p class="text-sm text-muted-foreground">Quantity: @_quantity (0 to 10)</p>
        </div>
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-4 text-card-foreground">Tree View &amp; Timeline</h2>
    <div class="grid gap-8 sm:grid-cols-2">
        <div>
            <TreeView @bind-SelectedValue="_selectedFile">
                <TreeViewItem Label="src" DefaultExpanded="true">
                    <TreeViewItem Label="Components" DefaultExpanded="true">
                        <TreeViewItem Label="Button.razor" />
                        <TreeViewItem Label="Chat.razor" />
                    </TreeViewItem>
                    <TreeViewItem Label="Program.cs" />
                </TreeViewItem>
                <TreeViewItem Label="README.md" />
            </TreeView>
            <p class="mt-2 text-sm text-muted-foreground">Selected: @(_selectedFile ?? "none")</p>
        </div>
        <Timeline>
            <TimelineItem Title="v0.3.0-rc.2 released" Time="Today" Active="true">Published to NuGet and GitHub.</TimelineItem>
            <TimelineItem Title="Charts restyled" Time="2 weeks ago">Donut, radar and radial charts added.</TimelineItem>
            <TimelineItem Title="Moved to .NET 10" Time="1 month ago" />
        </Timeline>
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-4 text-card-foreground">QR Code, Image Viewer &amp; Aspect Ratio</h2>
    <div class="grid items-start gap-6 sm:grid-cols-3">
        <div class="space-y-2">
            <QrCode Value="https://github.com/shellui-dev/shellui" Size="140" />
            <p class="text-xs text-muted-foreground">Scan to open the repo</p>
        </div>
        <div class="space-y-2">
            <ImageViewer Src="@SampleImage" Alt="Sample landscape" Class="h-32 w-full" />
            <p class="text-xs text-muted-foreground">Click to open, then zoom</p>
        </div>
        <div class="space-y-2">
            <AspectRatio Ratio="1.7777" Class="rounded-md bg-muted">
                <div class="flex items-center justify-center text-sm text-muted-foreground">16 : 9</div>
            </AspectRatio>
            <p class="text-xs text-muted-foreground">Keeps its ratio at any width</p>
        </div>
    </div>
</section>

<section class="border border-border rounded-lg p-6 bg-card mt-6">
    <h2 class="text-2xl font-semibold mb-4 text-card-foreground">Kbd</h2>
    <p class="text-sm text-muted-foreground">
        Open the command palette with <Kbd>Ctrl</Kbd> <Kbd>K</Kbd>, or toggle the sidebar with <Kbd>Ctrl</Kbd> <Kbd>B</Kbd>.
    </p>
</section>

@code {
    private readonly List<(string Role, string Text)> _messages = new()
    {
        ("assistant", "Hi! I'm a ShellUI chat demo. Ask me anything."),
    };

    private string? _draft;
    private bool _thinking;
    private string? _align = "center";
    private List<string> _formats = new() { "bold" };
    private string? _website;
    private string? _price;
    private decimal? _quantity = 1;
    private string? _selectedFile = "Chat.razor";

    private const string SampleImage = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='800' height='500'><defs><linearGradient id='s' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%2393c5fd'/><stop offset='1' stop-color='%23fde68a'/></linearGradient></defs><rect width='800' height='500' fill='url(%23s)'/><circle cx='620' cy='140' r='60' fill='%23fbbf24'/><path d='M0 380 L200 220 L360 360 L520 240 L800 400 L800 500 L0 500 Z' fill='%2334d399'/><path d='M0 430 L260 300 L460 440 L800 330 L800 500 L0 500 Z' fill='%23059669'/></svg>";

    private readonly string[] _suggestions = { "What is ShellUI?", "Show me a dialog example", "How do I add a theme?" };

    private string? _reasoning;
    private bool _reasoningStreaming;
    private TimeSpan? _reasoningTime;
    private string _toolState = "pending";
    private string? _toolResult;
    private bool _agentRunning;
    private const string ToolArguments = "{ \"query\": \"dialog focus trap\", \"limit\": 3 }";

    private async Task RunAgentAsync()
    {
        _agentRunning = true;
        _reasoning = "";
        _reasoningTime = null;
        _toolState = "pending";
        _toolResult = null;
        _reasoningStreaming = true;
        var started = DateTime.UtcNow;
        foreach (var word in "The user wants to know how dialogs keep focus. I should search the docs for the focus trap, then summarise what Tab does inside an open dialog.".Split(' '))
        {
            _reasoning += word + " ";
            StateHasChanged();
            await Task.Delay(90);
        }
        _reasoningStreaming = false;
        _reasoningTime = DateTime.UtcNow - started;
        _toolState = "running";
        StateHasChanged();
        await Task.Delay(1500);
        _toolResult = "[\n  \"overlays/dialog.md#focus\",\n  \"guides/accessibility.md\",\n  \"changelog.md#0-3-5\"\n]";
        _toolState = "done";
        _agentRunning = false;
    }

    private sealed class SignupModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        public bool Digest { get; set; } = true;
    }

    private IReadOnlyList<double> _layout = new[] { 20d, 55d, 25d };

    private readonly SignupModel _signup = new();
    private bool _signedUp;

    private readonly object _sampleJson = new
    {
        name = "ShellUI",
        version = "0.4.0-alpha.3",
        stable = false,
        stars = 42,
        targets = new[] { "net8.0", "net10.0" },
        theme = new { radius = "0.5rem", colors = new { primary = "oklch(0.21 0.006 285.88)", destructive = "oklch(0.58 0.24 28.48)" } },
        homepage = (string?)null
    };

    private async Task SendAsync(string text)
    {
        _messages.Add(("user", text));
        _thinking = true;
        StateHasChanged();
        await Task.Delay(800);
        _messages.Add(("assistant", $"You said:\n{text}"));
        _thinking = false;
    }
}
