<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ShellUI.Core\ShellUI.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Internal library - not packaged as NuGet -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The package's component source, which ComponentSource turns into CLI templates. -->
  <ItemGroup>
    <EmbeddedResource Include="..\ShellUI.Components\Components\*.razor" LogicalName="ShellUI.Components/Components/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\ShellUI.Components\Variants\*.cs" LogicalName="ShellUI.Components/Variants/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
